# ============================================================
#  Robô de Vagas de Estágio — variáveis de ambiente
#  Copie para .env (cp .env.example .env) e preencha.
# ============================================================

# --- Anthropic (obrigatório) --------------------------------
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de triagem/extração estruturada (Tool Use forçado)
CLAUDE_MODEL_TRIAGEM=claude-haiku-5-5
# Modelo do pitch/carta personalizada (só para vagas com score alto)
CLAUDE_MODEL_PITCH=claude-sonnet-5-5
# Esforço de raciocínio (low | medium | high | xhigh | max). Mais alto = mais caro.
CLAUDE_EFFORT_TRIAGEM=medium
CLAUDE_EFFORT_PITCH=medium
# Liga/desliga o pitch com o modelo maior
ENABLE_SONNET_PITCH=true
# Score mínimo para acionar o modelo de pitch
SONNET_PITCH_MIN_SCORE=85

# --- Telegram (OPCIONAL) -------------------------------------
# Por padrão os alertas ficam só no dashboard (bloco "🔔 Alertas").
# Preencha as duas variáveis abaixo apenas se quiser receber também no Telegram.
# Token do @BotFather, ex.: 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# Seu chat id (veja README: "Como descobrir o TELEGRAM_CHAT_ID")
TELEGRAM_CHAT_ID=
# Envia um resumo da execução no fim de cada rodada
TELEGRAM_ENVIAR_RESUMO=true

# --- Regras de negócio --------------------------------------
# Score mínimo para notificar (0-100)
MIN_SCORE=75
# Máximo de vagas NOVAS analisadas pelo Claude por execução (teto de custo)
MAX_VAGAS_POR_EXECUCAO=60
# Análises simultâneas após a 1ª chamada (que aquece o cache)
MAX_CONCORRENCIA=3
# Descrições maiores que isso são cortadas (com aviso no log)
MAX_DESCRICAO_CHARS=15000
# Ignora vagas publicadas há mais de N dias
DIAS_MAXIMOS_VAGA=30
# Estado aceito para vagas presenciais/híbridas (sigla e nome)
UF_PRESENCIAL=RJ
ESTADO_PRESENCIAL=Rio de Janeiro

# --- Coleta -------------------------------------------------
# Fontes ativas (separadas por vírgula): github,gupy
FONTES_ATIVAS=github,gupy
# Repositórios de vagas no GitHub
GITHUB_REPOS=backend-br/vagas,frontendbr/vagas,react-brasil/vagas
# Opcional localmente; no GitHub Actions o workflow injeta automaticamente.
# Sem token: 60 req/h. Com token: 5.000 req/h.
GITHUB_TOKEN=
# Termos de busca da Gupy (separados por ";"). O robô já pede só vagas de ESTÁGIO
# ao servidor, então use apenas a área/tecnologia.
GUPY_TERMOS=desenvolvimento;desenvolvedor;software;programação;sistemas;dados;python;javascript;react;node;full stack;front-end;back-end;tecnologia

# --- Caminhos -----------------------------------------------
DATABASE_PATH=data/vagas.db
PERFIL_PATH=data/perfil.json
DASHBOARD_PATH=docs/index.html

# --- Logs ---------------------------------------------------
LOG_LEVEL=INFO
